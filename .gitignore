target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar

# Flutter & Dart
.dart_tool/
.packages
build/
*.pub
*.apk
*.aab
*.ipa
.flutter-plugins
.flutter-plugins-dependencies

# Database Local Volumes & Logs
pgdata/
*.log
logs/

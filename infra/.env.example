# Hosil Local Development Environment Template
# Copy this file to .env in your root or infra/ directory for local overrides:
#   cp infra/.env.example infra/.env

# Local PostgreSQL 16 Configuration
POSTGRES_DB=hosil_db
POSTGRES_USER=hosil_dev
POSTGRES_PASSWORD=hosil_dev_secret

# Default port is 5433 (to avoid collision with local PostgreSQL on 5432).
POSTGRES_PORT=5433

# Backend Connection Settings
SPRING_PROFILES_ACTIVE=local
POSTGRES_HOST=localhost

# Application Security Placeholders (NEVER commit production secrets)
HOSIL_JWT_SECRET=dev_jwt_secret_must_be_at_least_256_bits_long_for_hmac_sha256_local_only
HOSIL_JWT_EXPIRATION_SECONDS=900
HOSIL_OTP_SECRET=dev_otp_hmac_secret_must_be_at_least_256_bits_long_local_only

# SMS / OTP Delivery Provider (DEC-003: provider pending legal/cost confirmation)
# Options: NOOP (default for local dev without Telegram), TELEGRAM (Milestone 6C.5), ESKIZ (future), PLAYMOBILE (future)
HOSIL_SMS_PROVIDER=NOOP
HOSIL_OTP_DELIVERY_PROVIDER=TELEGRAM

# Telegram OTP & Contact Linking Configuration (Milestone 6C.5)
# Obtain bot token from @BotFather on Telegram
HOSIL_BOT_TOKEN=your_telegram_bot_token_here
HOSIL_BOT_USERNAME=hosil_authentication_bot
HOSIL_TELEGRAM_POLLING_ENABLED=true
HOSIL_TELEGRAM_LINKING_TTL_SECONDS=600


